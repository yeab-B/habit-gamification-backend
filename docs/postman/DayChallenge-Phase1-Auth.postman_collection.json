{
  "info": {
    "name": "DayChallenge Phase 1 - Authentication & User Management",
    "description": "Postman collection for Phase 1 authentication APIs (Laravel Sanctum + Socialite + email verification).\n\nHow to use:\n1. Import this collection and the companion environment file.\n2. Set environment values like base_url and verify_url.\n3. Run Register or Login to auto-store auth_token.\n4. Use protected endpoints with Bearer auth.\n\nNotes:\n- Email verification endpoint uses Laravel signed URLs. For testing, copy the full signed URL from your email into verify_url.\n- Reset password requires token from email notification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f2f8e5db-2d09-4f4f-af34-0f6e8b8ee101"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Public",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yeabsira\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Create account, trigger email verification notification, and return Sanctum token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is success', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.environment.set('auth_token', json.data.token);",
                  "if (json?.data?.user?.id) pm.environment.set('user_id', json.data.user.id);",
                  "if (json?.data?.user?.email) pm.environment.set('user_email', json.data.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login with email and password. Requires verified email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.environment.set('auth_token', json.data.token);",
                  "if (json?.data?.user?.id) pm.environment.set('user_id', json.data.user.id);",
                  "if (json?.data?.user?.email) pm.environment.set('user_email', json.data.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{google_access_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/google/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "google",
                "login"
              ]
            },
            "description": "Authenticate with Google access token using Socialite."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.environment.set('auth_token', json.data.token);",
                  "if (json?.data?.user?.id) pm.environment.set('user_id', json.data.user.id);",
                  "if (json?.data?.user?.email) pm.environment.set('user_email', json.data.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "forgot-password"
              ]
            },
            "description": "Request a password reset token by email."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"token\": \"{{password_reset_token}}\",\n  \"password\": \"newpassword\",\n  \"password_confirmation\": \"newpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reset-password"
              ]
            },
            "description": "Reset password with token from email."
          }
        },
        {
          "name": "Verify Email (Signed URL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{verify_url}}",
              "host": [
                "{{verify_url}}"
              ]
            },
            "description": "Paste full signed verification URL (including query signature) into verify_url environment variable."
          }
        }
      ]
    },
    {
      "name": "Profile - Protected",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile"
              ]
            },
            "description": "Get authenticated user profile. Requires Bearer token and verified email."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Updated Name",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile"
              ]
            },
            "description": "Update profile name and optional avatar image (max 2MB)."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password\",\n  \"password\": \"newpassword\",\n  \"password_confirmation\": \"newpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "change-password"
              ]
            },
            "description": "Change account password and revoke all Sanctum tokens."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Logout from current device (revoke current token)."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile"
              ]
            },
            "description": "Soft delete authenticated account and revoke all tokens."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "user_email",
      "value": "user@example.com"
    },
    {
      "key": "google_access_token",
      "value": ""
    },
    {
      "key": "password_reset_token",
      "value": ""
    },
    {
      "key": "verify_url",
      "value": ""
    }
  ]
}
