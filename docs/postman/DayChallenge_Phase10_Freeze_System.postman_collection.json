{
  "info": {
    "name": "DayChallenge API - Phase 10 Freeze System",
    "description": "Phase 10 Freeze System endpoints for sending freezes to friends and viewing freeze history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "receiver_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Freezes",
      "item": [
        {
          "name": "Send Freeze",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": \"{{receiver_id}}\",\n  \"reason\": \"Get well soon!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/freezes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "freezes"
              ]
            },
            "description": "Sends one available freeze to an accepted friend. The sender must have enough coins and cannot send to themselves or non-friends."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"receiver_id\": \"{{receiver_id}}\",\n  \"reason\": \"Get well soon!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/freezes",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "freezes"
                  ]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": true,\n  \"message\": \"Freeze sent successfully\",\n  \"data\": {\n    \"id\": \"9a1b2c3d-4e5f-6789-abcd-ef0123456789\",\n    \"sender\": {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Yeabsira\",\n      \"email\": \"yeabsira@example.com\"\n    },\n    \"receiver\": {\n      \"id\": \"22222222-2222-2222-2222-222222222222\",\n      \"name\": \"Sara\",\n      \"email\": \"sara@example.com\"\n    },\n    \"status\": \"available\",\n    \"cost\": 3,\n    \"reason\": \"Get well soon!\",\n    \"used_at\": null,\n    \"created_at\": \"2026-07-12T09:00:00.000000Z\"\n  }\n}"
            },
            {
              "name": "Error - Non Friend",
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": false,\n  \"message\": \"You can only send freezes to accepted friends.\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "Freeze History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/freezes?type=received&status=available&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "freezes"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "received",
                  "description": "Optional. Use sent or received."
                },
                {
                  "key": "status",
                  "value": "available",
                  "description": "Optional. Use available, used, or expired."
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns paginated freeze history for the authenticated user. Includes both sent and received freezes unless filtered."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/freezes?type=received&status=available&page=1",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "freezes"
                  ],
                  "query": [
                    {
                      "key": "type",
                      "value": "received"
                    },
                    {
                      "key": "status",
                      "value": "available"
                    },
                    {
                      "key": "page",
                      "value": "1"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": true,\n  \"message\": \"Freezes retrieved successfully\",\n  \"data\": [\n    {\n      \"id\": \"9a1b2c3d-4e5f-6789-abcd-ef0123456789\",\n      \"sender\": {\n        \"id\": \"11111111-1111-1111-1111-111111111111\",\n        \"name\": \"Yeabsira\",\n        \"email\": \"yeabsira@example.com\"\n      },\n      \"receiver\": {\n        \"id\": \"22222222-2222-2222-2222-222222222222\",\n        \"name\": \"Sara\",\n        \"email\": \"sara@example.com\"\n      },\n      \"status\": \"available\",\n      \"cost\": 3,\n      \"reason\": \"Get well soon!\",\n      \"used_at\": null,\n      \"created_at\": \"2026-07-12T09:00:00.000000Z\"\n    }\n  ],\n  \"meta\": {\n    \"current_page\": 1,\n    \"last_page\": 1,\n    \"per_page\": 15,\n    \"total\": 1\n  }\n}"
            },
            {
              "name": "Error - Unauthenticated",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
