{
  "info": {
    "name": "DayChallenge API - Phase 13.2-13.6 FFGR Core Finance",
    "description": "FFGR Finance Engine: Budget (Asrat + Allocation), Expenses (Needs), Emergency Fund, Investments (Growth), and Reward Wallet. Every income is tithed (Asrat 10%), then the remaining 90% is split into Foundation (Needs 50% + Emergency 20%), Growth (Investments 20%), and Reward (10%).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Budget",
      "item": [
        {
          "name": "Get Budget (Current Month)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/finance/budget",
              "host": ["{{base_url}}"],
              "path": ["api", "finance", "budget"]
            },
            "description": "Returns the current month's budget overview: settings, aggregated totals (income, asrat, needs, emergency, investment, reward), and all allocations."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": true,\n  \"message\": \"Budget retrieved successfully\",\n  \"data\": {\n    \"settings\": {\n      \"id\": \"{{budget_settings_id}}\",\n      \"user_id\": \"{{user_id}}\",\n      \"asrat_percentage\": \"10.00\",\n      \"needs_percentage\": \"50.00\",\n      \"emergency_percentage\": \"20.00\",\n      \"investment_percentage\": \"20.00\",\n      \"reward_percentage\": \"10.00\"\n    },\n    \"month\": \"2026-07\",\n    \"totals\": {\n      \"income\": \"50000.00\",\n      \"asrat\": \"5000.00\",\n      \"needs\": \"22500.00\",\n      \"emergency\": \"9000.00\",\n      \"investment\": \"9000.00\",\n      \"reward\": \"4500.00\"\n    },\n    \"allocations\": []\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Budget Settings",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asrat_percentage\": 15,\n  \"needs_percentage\": 40,\n  \"emergency_percentage\": 25,\n  \"investment_percentage\": 20,\n  \"reward_percentage\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/finance/budget/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "finance", "budget", "settings"]
            },
            "description": "Customize allocation percentages. Defaults: Asrat 10%, Needs 50%, Emergency 20%, Investment 20%, Reward 10%. Percentages should sum to 100 for the remaining balance after Asrat."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": true,\n  \"message\": \"Budget settings updated successfully\",\n  \"data\": {\n    \"id\": \"{{budget_settings_id}}\",\n    \"user_id\": \"{{user_id}}\",\n    \"asrat_percentage\": \"15.00\",\n    \"needs_percentage\": \"40.00\",\n    \"emergency_percentage\": \"25.00\",\n    \"investment_percentage\": \"20.00\",\n    \"reward_percentage\": \"15.00\"\n  }\n}"
            },
            {
              "name": "Validation Error",
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": false,\n  \"message\": \"The given data was invalid.\",\n  \"errors\": {\n    \"asrat_percentage\": [\n      \"The asrat percentage must be between 0 and 100.\"\n    ]\n  }\n}"
            }
          ]
        }
      ]
    },
